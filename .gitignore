.nuxt/
.output/
.nitro/
.svelte-kit/
.astro/
.turbo/
.cache/
.parcel-cache/
.vite/
.vitepress/dist
.vitepress/cache
.docusaurus/
.serverless/
.fusebox/
.firebase/
.dynamodb/
*.tgz
*.whl
*.jar
*.war

