ml_debug.html
olx_*.html
olx_*.json
olx_*.txt
resultados.json
*.stackdump

# Arquivos com nome corrompido (temporarios)
*Ctmpparse_alerts.py
*tmpparse_alerts.py

# ------------------------------------------------------------
# PROJETO: Adota Patos (especificos)
# ------------------------------------------------------------
# Handoffs antigos (preservados localmente; nao precisam subir)
# docs/HANDOFF-*.md   # descomente se nao quiser versionar

# Seeds de desenvolvimento (podem conter dados de teste)
# supabase/seed-dev-john.sql   # descomente se nao quiser versionar

# Deno lock (gerado; opcional versionar)
# deno.lock   # descomente se nao quiser versionar