*.pem
*.p12
*.pfx
*.key
*.crt
*.cer
*.der
*.csr
*.jks
*.keystore

# ------------------------------------------------------------
# ARTEFATOS DE SCAN DE SEGURANCA (ZAP)
# ------------------------------------------------------------
zap-artifacts*/
zap-report*/
zap-*.json
zap-*.yaml
zap.yaml
zap-out-*.json

