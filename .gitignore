# ============================================================
# .gitignore — Adota Patos
# Pesquisa avancada de boas praticas (GitHub gitignore templates,
# OWASP, 12-factor). Objetivo: nunca subir segredos, dependencias,
# builds, arquivos de sistema/editor, logs, temporarios nem
# artefatos de scan.
# ============================================================

# ------------------------------------------------------------
# SEGREDOS E CONFIGURACAO (NUNCA COMMITAR)
# ------------------------------------------------------------
.env
.env.*
!.env.example
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
*.der
credentials*.json
secrets*.json
secrets/
.secrets/
*.secret
config.local.*
.local-config
.pypirc
.streamlit/secrets.toml
serviceAccount*.json
firebase-adminsdk*.json
*.keystore
*.jks

# Supabase: chave publicavel pode viver no front, mas nunca
# service_role / sb_secret / sbp_ / dumps locais.
supabase/.temp/
supabase/.branches/
supabase/.logs/
backend/supabase/.temp/
backend/supabase/.branches/
backend/supabase/.logs/
*.dump
*.sql.gz

# ------------------------------------------------------------
# DEPENDENCIAS
# ------------------------------------------------------------
node_modules/
jspm_packages/
web_modules/
__pycache__/
*.py[codz]
*$py.class
.Python
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
.conda/
conda-meta/
poetry.lock
Pipfile.lock
uv.lock
pdm.lock
.pixi/
__pypackages__/

