# Copie este arquivo para .env e preencha com os valores reais.
# O .env está no .gitignore — NUNCA commite credenciais.

# ---- Frontend (valores públicos, seguros COM Row Level Security ativa) ----
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# ---- Edge Function (segredos: configure com `supabase secrets set`) ----
CHAVE_SERVIDOR=sb_secret_xxxxxxxxxxxxxxxx

# ---- Supabase CLI (deploy e administração; nunca no navegador) ----
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxx
SUPABASE_DB_PASSWORD=senha-do-banco
