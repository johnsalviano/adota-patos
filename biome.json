{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/test-results",
      "!**/playwright-report",
      "!**/docs",
      "!**/.github",
      "!**/backend/supabase/functions",
      "!**/package-lock.json"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noAssignInExpressions": "off",
        "noVar": "off",
        "noRedundantUseStrict": "off"
      },
      "correctness": {
        "noInnerDeclarations": "off",
        "noUnusedVariables": "off"
      },
      "a11y": {
        "useHeadingContent": "off"
      },
      "complexity": {
        "noImportantStyles": "off",
        "useArrowFunction": "off",
        "noArguments": "off"
      },
      "style": {
        "useTemplate": "off",
        "noDescendingSpecificity": "off",
        "noNonNullAssertion": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
